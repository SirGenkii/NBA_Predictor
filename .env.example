# Environment configuration for NBA Predictor
NBA_ENV=dev
NBA_SETTINGS_FILE=settings.toml

# Data roots (override if repository is mounted elsewhere)
NBA_DATA_ROOT=./data

# Feast configuration
FEAST_OFFLINE_PATH=./data/silver/feast_offline
FEAST_REGISTRY_PATH=./data/feature_repo/registry.db
FEAST_ONLINE_HOST=localhost
FEAST_ONLINE_PORT=5432
FEAST_ONLINE_DATABASE=feast
FEAST_ONLINE_USER=feast
FEAST_ONLINE_PASSWORD=feast

# MLflow configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=nba_predictor
MLFLOW_MODEL_NAME=nba_predictor

# Prefect configuration
PREFECT_API_URL=http://localhost:4200/api
PREFECT_WORK_QUEUE=default

# Misc
NBA_INGEST_TS=
NBA_DEBUG_TEAM_ID=1610612747
NBA_DEBUG_OPP_ID=1610612738
NBA_PREDICTOR_MODEL_URI=models:/nba_predictor/Production

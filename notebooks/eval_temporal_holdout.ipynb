 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Évaluation holdout (walk-forward)\n",
    "\n",
    "Objectif : charger un modèle MLflow déjà entraîné et l'évaluer sur le jeu de test final des splits temporels (row-level) pour inspecter les perfs et extraire des lignes jamais vues en train.\n",
    "\n",
    "Adapter les variables de config ci-dessous (`RUN_ID`, `TARGET`, etc.)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import mlflow\n",
    import numpy as np\n",
    "import pandas as pd\n",
    "from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\n",
    "\n",
    "from src.modeling.builders import point_total_bundle, is_win_bundle\n",
    "from src.modeling.data import prepare_features, generate_walk_forward_folds, train_test_split_data\n",
    "from src.modeling.trainer import ModelTrainer\n",
    "from src.modeling.metrics import regression_metrics, classification_metrics\n",
    "from src.modeling.trainer import ModelTrainer\n",
    "\n",
    "pd.set_option(\"display.max_columns\", 120)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Config ---\n",
    "RUN_ID = \"<run_id_mlflow>\"  # ex: \"35791e571c0949edb7e3708457a07a7d\"\n",
    "TARGET = \"POINT_TOTAL\"  # ou \"IS_WIN\"\n",
    "USE_REGISTRY = False\n",
    "REGISTRY_MODEL_URI = \"models:/point_total_stacking/Production\"  # si USE_REGISTRY=True\n",
    "\n",
    "# Choisir le bundle (dataset + training config)\n",
    "bundle = point_total_bundle()\n",
    "if TARGET.upper() == \"IS_WIN\":\n",
    "    bundle = is_win_bundle()\n",
    "\n",
    "dataset_cfg = bundle.dataset\n",
    "training_cfg = bundle.training\n",
    "print(\"dataset path:\", dataset_cfg.resolve_path())\n",
    "print(\"split strategy:\", training_cfg.split_strategy, \"seasons:\", training_cfg.train_seasons, training_cfg.calibration_seasons, training_cfg.test_seasons)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Charger dataset et reconstruire les splits ---\n",
    "from src.modeling.data import load_dataset\n",
    "\n",
    "df = load_dataset(dataset_cfg)\n",
    "X, y, feature_names = prepare_features(df, dataset_cfg)\n",
    "\n",
    "if training_cfg.split_strategy == \"walk_forward\":\n",
    "    folds = generate_walk_forward_folds(X, y, training_cfg, df_meta=df)\n",
    "    split = folds[-1]  # dernier fold = holdout final\n",
    "else:\n",
    "    split = train_test_split_data(X, y, training_cfg, df_meta=df)\n",
    "\n",
    "X_test = split.X_test\n",
    "y_test = split.y_test\n",
    "print(\"Test rows:\", len(X_test))\n",
    "if \"SEASON\" in df.columns:\n",
    "    seasons_test = df.loc[X_test.index, \"SEASON\"].astype(str).unique().tolist()\n",
    "    print(\"Seasons in test:\", seasons_test)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Charger le modèle MLflow ---\n",
    "if USE_REGISTRY:\n",
    "    model_uri = REGISTRY_MODEL_URI\n",
    "else:\n",
    "    model_uri = f\"runs:/{RUN_ID}/model\"\n",
    "print(\"Model URI:\", model_uri)\n",
    "\n",
    "model = mlflow.sklearn.load_model(model_uri)\n",
    "\n",
    "# Note: si le modèle est un stacking ou un pipeline, il doit accepter les colonnes dans le même ordre qu'à l'entraînement."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Prédictions et métriques ---\n",
    "y_pred = model.predict(X_test)\n",
    "\n",
    "if training_cfg.task_type == \"regression\":\n",
    "    rmse = mean_squared_error(y_test, y_pred, squared=False)\n",
    "    mae = mean_absolute_error(y_test, y_pred)\n",
    "    r2 = r2_score(y_test, y_pred)\n",
    "    print({\"rmse\": rmse, \"mae\": mae, \"r2\": r2})\n",
    "else:\n",
    "    if hasattr(model, \"predict_proba\"):\n",
    "        y_proba = model.predict_proba(X_test)[:, 1]\n",
    "    else:\n",
    "        y_proba = model.predict(X_test)\n",
    "    print(classification_metrics(y_test, pd.Series(model.predict(X_test)), pd.Series(y_proba)))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Inspection des lignes de test (jamais vues en train dans le dernier fold) ---\n",
    "test_rows = df.loc[X_test.index].copy()\n",
    "test_rows[\"y_true\"] = y_test\n",
    "test_rows[\"y_pred\"] = y_pred\n",
    "test_rows[\"abs_err\"] = (y_test - y_pred).abs()\n",
    "\n",
    "display(test_rows.head())\n",
    "print(\"Top 10 erreurs absolues :\")\n",
    "display(test_rows.sort_values(\"abs_err\", ascending=False).head(10)[[\"GAME_ID\", \"GAME_DATE\", \"SEASON\", \"y_true\", \"y_pred\", \"abs_err\"]])"
   ]
  }
 ],
